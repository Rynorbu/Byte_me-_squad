# Production Dockerfile for Vite + React Application
# Multi-stage build to optimize image size and security

# Stage 1: Builder
FROM node:20-alpine AS builder
WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 make g++

# Copy package files
COPY package.json package-lock.json ./

# Install all dependencies (including dev)
RUN npm ci

# Copy source code
COPY . .

# Build Vite application
RUN npm run build

# Stage 2: Runtime (using nginx to serve static files)
FROM node:20-alpine AS runner
WORKDIR /app

# Install dumb-init and simple-http-server for serving static files
RUN apk add --no-cache dumb-init

# Install a lightweight HTTP server (alternatively can use nginx)
RUN npm install -g serve

# Create non-root user for security
RUN addgroup -g 1001 -S appuser && \
    adduser -S appuser -u 1001

# Copy built application from builder
COPY --from=builder --chown=appuser:appuser /app/dist ./dist

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]

# Start serving the application
CMD ["serve", "-s", "dist", "-l", "3000"]
